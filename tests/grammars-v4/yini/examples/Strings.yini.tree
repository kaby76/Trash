(yini (section ^ Strings\n\n (section_members (member \t^^  String_Concatenation\n\t/*\n\t\tAll below should result in the following string literal:\n\t\tThe boat's name is "Mare Stella"\n\t*/\n\n (section_members (member text1 = (value (string_literal "The boat's name is " (string_concat + '"Mare Stella"'))) \n) (member text2 = (value (string_literal "The boat's name is " (string_concat + \n '"Mare Stella"'))) \n \n) (member text3 = (value (string_literal "The boat's name " (string_concat + 'is "Mare Stella"'))) \n) (member text4 = (value (string_literal "The boat's name " (string_concat + \n 'is "Mare Stella"'))) \n \n) (member text5 = (value (string_literal C'The boat\'s name is "Mare Stella"')) \n) (member text6 = (value (string_literal C"The boat's name is \"Mare Stella\"")) \n \n) (member \t^^  DifferentKindOfStrings\n\n\t// Using a Raw String (default).\n (section_members (member string1 = (value (string_literal "")) \n) (member string2 = (value (string_literal "Pets")) \n) (member string3 = (value (string_literal "Pets are animals")) \n) (member rawString = (value (string_literal "Pets are animals kept for companionship or entertainment, rather than as a working animal, livestock or laboratory animal. Two of the most popular pets are dogs and cats. Other animals include fish, birds, rabbits, rodents, ferrets, pigs and many other.")) \n \n \t// Using a Hyper String.\n) (member hyperString = (value (string_literal h"Pets are animals kept for companionship or entertainment,\n\t\trather than as a working animal, livestock or laboratory animal. Two\n\t\tof the most popular pets are dogs and cats. Other animals include\n\t\tfish, birds, rabbits, rodents, ferrets, pigs and many other.")) \n \n \t// Using a Classic String.\n) (member classicString = (value (string_literal c"Pets are animals kept for companionship or entertainment,\n" (string_concat + \n "\trather than as a working animal, livestock or laboratory animal. Two\n") (string_concat + \n "\tof the most popular pets are dogs and cats.\n") (string_concat + \n "\tOther animals include fish, birds, rabbits, rodents, ferrets, pigs and many other.\n"))) \n))))))) <EOF>)