<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/trparse/trparse.csproj" />
  </ItemGroup>

  <!-- Copy ABNF interp files and example inputs to the test output directory. -->
  <ItemGroup>
    <Content Include="../../examples/abnf-interp/interp/Abnf.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/interp/Abnf.interp" />
    <Content Include="../../examples/abnf-interp/interp/AbnfLexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/interp/AbnfLexer.interp" />
    <Content Include="../../examples/abnf-interp/examples/*.abnf"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/examples/%(Filename)%(Extension)" />
    <Content Include="../../examples/abnf-interp/examples/apg-java/*.bnf"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/examples/apg-java/%(Filename)%(Extension)" />

    <!-- MySQL (Positive-Technologies) interp files and SQL examples -->
    <Content Include="../grammars-v4/Positive-Technologies/interp/MySqlParser.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/mysql-interp/MySqlParser.interp" />
    <Content Include="../grammars-v4/Positive-Technologies/interp/MySqlLexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/mysql-interp/MySqlLexer.interp" />
    <Content Include="../grammars-v4/Positive-Technologies/examples/*.sql"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/mysql-examples/%(Filename)%(Extension)" />

    <!-- SysML v2 interp files, inputs, and native CSharp parse trees -->
    <Content Include="../grammars-v4/sysml-v2/interp/SysMLv2Parser.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/sysml-v2/interp/SysMLv2Parser.interp" />
    <Content Include="../grammars-v4/sysml-v2/interp/SysMLv2Lexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/sysml-v2/interp/SysMLv2Lexer.interp" />
    <Content Include="../grammars-v4/sysml-v2/examples/*.sysml"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/sysml-v2/examples/%(Filename)%(Extension)" />
    <Content Include="../grammars-v4/sysml-v2/examples/*.sysml.tree"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/sysml-v2/examples/%(Filename)%(Extension)" />

    <!-- SystemVerilog interp files, inputs, and native CSharp parse trees -->
    <Content Include="../grammars-v4/systemverilog/interp/SystemVerilogParser.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/systemverilog/interp/SystemVerilogParser.interp" />
    <Content Include="../grammars-v4/systemverilog/interp/SystemVerilogLexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/systemverilog/interp/SystemVerilogLexer.interp" />
    <Content Include="../grammars-v4/systemverilog/examples/*.sv"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/systemverilog/examples/%(Filename)%(Extension)" />
    <Content Include="../grammars-v4/systemverilog/examples/*.sv.tree"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/systemverilog/examples/%(Filename)%(Extension)" />

    <!-- ACME interp files, inputs, and native CSharp parse trees -->
    <Content Include="../grammars-v4/acme/interp/acme.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/acme/interp/acme.interp" />
    <Content Include="../grammars-v4/acme/interp/acmeLexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/acme/interp/acmeLexer.interp" />
    <Content Include="../grammars-v4/acme/examples/**/*.acmetest"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/acme/examples/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../grammars-v4/acme/native/*.tree"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/acme/native/%(Filename)%(Extension)" />

    <!-- AQL interp files, precedence-sensitive inputs, and native CSharp trees -->
    <Content Include="../grammars-v4/aql/interp/ArangoDbParser.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/aql/interp/ArangoDbParser.interp" />
    <Content Include="../grammars-v4/aql/interp/ArangoDbLexer.interp"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/aql/interp/ArangoDbLexer.interp" />
    <Content Include="../grammars-v4/aql/examples/*.aql"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/aql/examples/%(Filename)%(Extension)" />
    <Content Include="../grammars-v4/aql/native/*.tree"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestData/aql/native/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
