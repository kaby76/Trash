<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <AssemblyName>trmachine</AssemblyName>
    <PackageId>trmachine</PackageId>
    <ToolCommandName>trmachine</ToolCommandName>
    <Version>5.1.0</Version>
    <Description>Print machine hardware and operating-system details for performance reports.</Description>
    <RepositoryUrl>https://github.com/kaby76/Trash/tree/main/src/trmachine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

