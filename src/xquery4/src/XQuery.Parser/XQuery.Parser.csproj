<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
<RootNamespace>XQuery.Parser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.10.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="xpath4\Generated-CSharp\**" />
    <Compile Remove="xquery4\Generated-CSharp\**" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="xpath4\XPath4Lexer.g4" />
    <Antlr4 Include="xpath4\XPath4Parser.g4" />
    <Antlr4 Include="xquery4\XQuery4Lexer.g4" />
    <Antlr4 Include="xquery4\XQuery4Parser.g4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XQuery.DataModel\XQuery.DataModel.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;3021</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

</Project>
